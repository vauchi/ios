# SwiftFormat configuration — aligned with project conventions

# Disable wrapMultilineStatementBraces to match SwiftLint opening_brace rule
--disable wrapMultilineStatementBraces

# Exclude build artifacts and dependency checkouts
--exclude build,Vauchi/Generated

# CI and every developer run the same swiftformat; an older one fails
# here instead of passing code CI then rejects (#489).
--minversion 0.63.1
